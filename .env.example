# ZMedico — environment variables
#
# Copy to `.env` and fill in. Every variable is read at BUILD time by Vite,
# so changing one requires a rebuild and redeploy, not just a restart.
#
# NOTE: `.env` is currently committed to this repository. That is only safe
# because every value below is a publishable/public key. Never add a
# service-role key, a database password, or a provider API secret to it —
# those belong in Supabase Edge Function secrets or GitHub Actions secrets.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project REST endpoint and publishable key. Both are public by design: the
# publishable key is embedded in the browser bundle and is gated by RLS.
VITE_SUPABASE_URL="https://rqcmnfzfytyyicelvifk.supabase.co"
VITE_SUPABASE_PROJECT_ID="rqcmnfzfytyyicelvifk"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------------------------------------------------------------------------
# Authorization (required)
# ---------------------------------------------------------------------------
# "true"  -> permissions come from the canonical authz_* bundle tables
#            (v_authz_effective_permissions). This is the current production
#            setting and the migration behind it is complete.
# "false" -> falls back to the legacy role_permissions table.
VITE_AUTHZ_CANONICAL="true"

# ---------------------------------------------------------------------------
# Error monitoring (optional, currently OFF)
# ---------------------------------------------------------------------------
# Without a DSN, src/lib/observability/sentry.ts short-circuits before touching
# the network and the app runs with NO error reporting at all — production
# crashes are invisible until a user phones in. Strongly recommended for a
# clinical system.
#
# To turn it on:
#   1. Create a free project at https://sentry.io (platform: React)
#   2. Copy the DSN it gives you (looks like https://<key>@o<org>.ingest.sentry.io/<project>)
#   3. Set VITE_SENTRY_DSN below, then rebuild and redeploy
#
# The SDK is loaded lazily from a CDN, so enabling this adds no npm dependency
# and no cost to the initial page load.
VITE_SENTRY_DSN=""

# Environment label shown in Sentry. Defaults to "production".
VITE_SENTRY_ENV="production"

# Fraction of transactions traced for performance monitoring, 0 to 1.
# Leave at 0 unless you are actively investigating slowness.
VITE_SENTRY_TRACES_SAMPLE_RATE="0"

# Optional release identifier so Sentry can group errors by deployed version.
# VITE_APP_VERSION=""
# VITE_COMMIT_SHA=""
