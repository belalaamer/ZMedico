{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zmedico.platform/schemas/appointment/v1.json",
  "title": "Appointment",
  "type": "object",
  "x-entity": "appointment",
  "x-version": "1.0.0",
  "x-owner": "Head of Clinic Ops",
  "x-steward": "Front-Desk Data Steward",
  "x-domain": "appointments",
  "x-source": "public.appointments",
  "x-classification": "PHI",
  "x-retention": "RET-APPT-01",
  "required": ["id", "patient_id", "start_at", "status", "created_at"],
  "properties": {
    "id":             { "type": "string", "format": "uuid" },
    "tenant_id":      { "type": ["string", "null"], "format": "uuid" },
    "branch_id":      { "type": ["string", "null"], "format": "uuid" },
    "patient_id":     { "type": "string", "format": "uuid", "x-classification": "PHI-LINK" },
    "doctor_id":      { "type": ["string", "null"], "format": "uuid" },
    "service_id":     { "type": ["string", "null"], "format": "uuid" },
    "start_at":       { "type": "string", "format": "date-time", "x-quality-rules": ["DQ-APT-01"] },
    "end_at":         { "type": ["string", "null"], "format": "date-time", "x-quality-rules": ["DQ-APT-02"] },
    "status":         { "type": "string", "enum": ["scheduled", "confirmed", "in_progress", "completed", "cancelled", "no_show", "departed"] },
    "priority":       { "type": ["integer", "null"], "minimum": 0 },
    "checked_in_at":  { "type": ["string", "null"], "format": "date-time" },
    "started_at":     { "type": ["string", "null"], "format": "date-time" },
    "notes":          { "type": ["string", "null"], "x-classification": "PHI" },
    "created_by":     { "type": ["string", "null"], "format": "uuid" },
    "created_at":     { "type": "string", "format": "date-time" },
    "updated_at":     { "type": ["string", "null"], "format": "date-time" },
    "deleted_at":     { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": true
}
