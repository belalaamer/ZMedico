{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zmedico.platform/schemas/patient/v1.json",
  "title": "Patient",
  "description": "Canonical patient aggregate as exposed at the domain boundary. Mirrors public.patients as of 2026-07-13. Non-authoritative for storage; authoritative for downstream consumers.",
  "type": "object",
  "x-entity": "patient",
  "x-version": "1.0.0",
  "x-owner": "Head of Clinic Ops",
  "x-steward": "Clinic Ops Data Steward",
  "x-domain": "patients",
  "x-source": "public.patients",
  "x-classification": "PHI",
  "x-retention": "RET-PATIENT-01",
  "required": ["id", "patient_code", "first_name_en", "last_name_en", "created_at"],
  "properties": {
    "id":              { "type": "string", "format": "uuid", "x-classification": "internal" },
    "tenant_id":       { "type": ["string", "null"], "format": "uuid", "x-classification": "internal" },
    "branch_id":       { "type": ["string", "null"], "format": "uuid", "x-classification": "internal" },
    "patient_code":    { "type": "string", "minLength": 1, "x-classification": "PII", "x-quality-rules": ["DQ-PAT-01"] },
    "first_name_en":   { "type": "string", "minLength": 1, "x-classification": "PII", "x-quality-rules": ["DQ-PAT-02"] },
    "last_name_en":    { "type": "string", "minLength": 1, "x-classification": "PII", "x-quality-rules": ["DQ-PAT-02"] },
    "first_name_ar":   { "type": ["string", "null"], "x-classification": "PII" },
    "last_name_ar":    { "type": ["string", "null"], "x-classification": "PII" },
    "date_of_birth":   { "type": ["string", "null"], "format": "date", "x-classification": "PHI", "x-quality-rules": ["DQ-PAT-03"] },
    "gender":          { "type": ["string", "null"], "enum": ["male", "female", "other", null], "x-classification": "PHI" },
    "national_id":     { "type": ["string", "null"], "x-classification": "PII-SENSITIVE", "x-quality-rules": ["DQ-PAT-04"] },
    "phone":           { "type": ["string", "null"], "x-classification": "PII", "x-quality-rules": ["DQ-PAT-05"] },
    "email":           { "type": ["string", "null"], "format": "email", "x-classification": "PII" },
    "address":         { "type": ["string", "null"], "x-classification": "PII" },
    "blood_group":     { "type": ["string", "null"], "x-classification": "PHI" },
    "allergies":       { "type": ["string", "null"], "x-classification": "PHI" },
    "chronic_diseases":{ "type": ["string", "null"], "x-classification": "PHI" },
    "notes":           { "type": ["string", "null"], "x-classification": "PHI" },
    "created_by":      { "type": ["string", "null"], "format": "uuid", "x-classification": "internal" },
    "created_at":      { "type": "string", "format": "date-time", "x-classification": "internal" },
    "updated_at":      { "type": ["string", "null"], "format": "date-time", "x-classification": "internal" },
    "deleted_at":      { "type": ["string", "null"], "format": "date-time", "x-classification": "internal" }
  },
  "additionalProperties": true
}
